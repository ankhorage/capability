{
  "name": "@ankhorage/capability",
  "version": "0.1.0",
  "description": "Generic runtime validation, normalization, equality, and catalog operations for Ankhorage capabilities.",
  "license": "MIT",
  "homepage": "https://github.com/ankhorage/capability#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/capability/issues"
  },
  "keywords": [
    "ankhorage",
    "capability",
    "validation",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/capability.git"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:standalone": "bun run build && bun test tests/standalone.test.ts",
    "docs": "bunx @ankhorage/paradox && ankhorage-prettier --write README.md paradox",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version"
  },
  "dependencies": {
    "@ankhorage/contracts": "^25.0.0",
    "@ankhorage/utility": "^1.9.85"
  },
  "devDependencies": {
    "@ankhorage/doctor": "^0.14.5",
    "@ankhorage/devtools": "^2.3.6",
    "@ankhorage/paradox": "^0.2.28",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
